# 访问口令：设置后除 /api/health 外所有 /api/* 需 Authorization: Bearer <token>
# 留空或不设置则不启用（本地开发默认不启用）
ACCESS_TOKEN=

# SQLite 数据库文件路径（默认 backend/autograde.db）
DATABASE_PATH=

# AI 接入（OpenAI 兼容协议，默认 DeepSeek）
# API key 自行到 platform.deepseek.com 申请后填在这里
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
