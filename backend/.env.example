# ============ 运行模式 ============
# false=开发（验证码打印日志、图形验证码 bypass）；true=生产（真实发信、强制人机验证）
IS_PROD=false

# ============ 认证（JWT） ============
# 生产必填！生成：python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# ============ 邮件（Resend，HTTP API 直调） ============
# Resend API key（账号级，可与 Stellaris 共用同一个）
RESEND_API_KEY=
# 发件人：名称 <本地部分@已验证域名>；域名需在 Resend 后台通过 DNS 验证
RESEND_FROM=Autograde <noreply@mail.example.com>

# ============ 数据库 ============
# SQLite 文件路径（默认 backend/autograde.db）
# Zeabur 部署时指到挂载卷：/app/data/autograde.db
DATABASE_PATH=

# ============ 前端静态目录（单服务部署） ============
# 默认 ../frontend/dist（vite build 产物）；留空用默认
FRONTEND_DIST=

# ============ AI 接入（OpenAI 兼容协议，默认 DeepSeek） ============
# API key 自行到 platform.deepseek.com 申请后填在这里
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
